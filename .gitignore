*.csv

# ─── Graphify Knowledge Graph ────────────────────────────────
graphify-out/

# ─── Android Keystores & Signing Secrets ─────────────────────
*.jks
*.keystore
*.pepk
*.p12
signing.properties

# ─── System / OS Caches ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Standalone TS / JS Plugin Testing ────────────────────────
/test ts/
