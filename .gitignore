# ─────────────────────────────────────────────────────────────
# NeoQN (QuickNovel-Enhanced) — Master Git Ignore Configuration
# ─────────────────────────────────────────────────────────────

# ─── Build Outputs & Gradle Caches ───────────────────────────
.gradle/
.gradle-home/
build/
.externalNativeBuild
.cxx
.kotlin/
*.class
*.jar
*.lock
*.bins
build_*.txt
git_status.tmp

# ─── IDE Settings & Configurations ───────────────────────────
.idea/
*.iml
.vscode/
/captures

# ─── Android SDK & Local Properties ──────────────────────────
/local.properties
gradle.properties

# ─── Python Virtual Environments ─────────────────────────────
.venv/

# ─── Scratch / Temp Scripts ───────────────────────────────────
